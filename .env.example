# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/titan

# Github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google sign-in (optional; identity/profile only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar (server-side service account; share this calendar with client_email)
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/google-calendar.json
GOOGLE_CALENDAR_ID=

# AI Copilot
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
